{
  "name": "cleanlink",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3020 --webpack",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1 --port 3020",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "db:setup": "tsx scripts/setup-database.ts",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "setup": "tsx scripts/setup-environment.ts"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "mysql2": "3.24.6",
    "@next/env": "16.4.3"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tsx": "^4.21.0"
  },
  "type": "module"
}
